{
  "expo": {
    "name": "FitBet",
    "slug": "fitbet",
    "scheme": "fitbet",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": [
      "**/*"
    ],
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#071D2A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.fitbet.app",
      "buildNumber": "1",
      "requireFullScreen": true,
      "infoPlist": {
        "NSCameraUsageDescription": "FitBet þarf aðgang að myndavél til að taka sönnunarmyndir af áskorunum.",
        "NSPhotoLibraryUsageDescription": "FitBet þarf aðgang að myndasafni til að hlaða upp sönnunarmyndum og myndböndum.",
        "NSPhotoLibraryAddUsageDescription": "FitBet þarf leyfi til að vista myndir.",
        "NSMicrophoneUsageDescription": "FitBet þarf hljóðnema til að taka sönnunarmyndbönd.",
        "NSMotionUsageDescription": "FitBet notar hreyfiskynjarann til að rekja líkamsþjálfun.",
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.fitbet.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#071D2A"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.RECORD_AUDIO",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#21A56A",
          "defaultChannel": "default",
          "androidMode": "default",
          "androidCollapsedTitle": "FitBet"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "FitBet þarf aðgang að myndasafni til að hlaða upp sönnunarmyndum.",
          "cameraPermission": "FitBet þarf aðgang að myndavél til að taka sönnunarmyndir."
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "b521fa2f-ed33-4a86-a63a-5787c27830d5"
      }
    },
    "owner": "fitbet"
  }
}
