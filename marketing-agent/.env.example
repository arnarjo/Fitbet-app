# FitBet Marketing Agent — Environment Variables
# Copy this file: cp .env.example .env
# Then fill in each value you have.
# The agent works with ANY subset — only features with credentials active.

# ── Required ──────────────────────────────────────────────────────────────────

# Anthropic API key — get at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-YOUR_KEY_HERE

# ── Facebook + Instagram (Meta Graph API) ─────────────────────────────────────
# See ACCESS_GUIDE.md → Part 1 for step-by-step setup

# Long-lived Page Access Token (valid 60 days, then refresh)
FACEBOOK_PAGE_ACCESS_TOKEN=

# Your Facebook Page numeric ID (e.g. 123456789012345)
FACEBOOK_PAGE_ID=

# Instagram Business Account numeric ID
# (found in Meta Business Suite → Instagram account settings)
INSTAGRAM_USER_ID=

# ── TikTok (Content Posting API) ──────────────────────────────────────────────
# See ACCESS_GUIDE.md → Part 2 for step-by-step setup
# Requires TikTok for Business + Content Posting API approval

TIKTOK_ACCESS_TOKEN=

# ── Image Generation (DALL-E 3 via OpenAI) ────────────────────────────────────
# See ACCESS_GUIDE.md → Part 3
# Get at https://platform.openai.com/api-keys

OPENAI_API_KEY=

# ── Image Hosting (Supabase Storage) ──────────────────────────────────────────
# Uses the same Supabase project as the FitBet app.
# Create a public bucket called "marketing-images" in Supabase dashboard.
# SUPABASE_URL is already in your app's .env — copy it here.
# SUPABASE_SERVICE_KEY is the "service_role" key (NOT the anon key).

SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ── Optional ──────────────────────────────────────────────────────────────────

# Claude model override
# Options: claude-opus-4-7 (smartest), claude-sonnet-4-6 (default), claude-haiku-4-5-20251001 (fastest)
# FITBET_MARKETING_MODEL=claude-sonnet-4-6
