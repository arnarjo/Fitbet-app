# FitBet Marketing Agent — Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── Required ──────────────────────────────────────────────────────────────────

# Your Anthropic API key — get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-YOUR_KEY_HERE

# ── Optional ──────────────────────────────────────────────────────────────────

# Claude model to use (default: claude-sonnet-4-6)
# Options: claude-opus-4-7 (smartest), claude-sonnet-4-6 (fast+smart), claude-haiku-4-5-20251001 (fastest)
# FITBET_MARKETING_MODEL=claude-sonnet-4-6
