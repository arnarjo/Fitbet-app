# .env.local  –  FitBet environment variables
# Copy this to .env and fill in your values

# ── Supabase ────────────────────────────────────────────────
# Get these from: https://app.supabase.com → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# ── Strava (optional, for activity auto-complete) ──────────
# Create app at: https://www.strava.com/settings/api
STRAVA_CLIENT_ID=YOUR_STRAVA_CLIENT_ID
STRAVA_CLIENT_SECRET=YOUR_STRAVA_CLIENT_SECRET
STRAVA_REDIRECT_URI=fitbet://strava-callback

# ── Push Notifications (Expo) ──────────────────────────────
# Get from: https://expo.dev → your project → Push notifications
EXPO_PUBLIC_PROJECT_ID=YOUR_EXPO_PROJECT_ID

# ── Sports API (optional – app works without it) ──────────
# If you want live match data, sign up at football-data.org (free tier available)
FOOTBALL_DATA_API_KEY=YOUR_KEY_HERE
